{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boreal.work/schemas/records/work-item.schema.json",
  "title": "Boreal Work Item",
  "type": "object",
  "required": ["meta", "kind", "title", "description", "status", "priority", "acceptanceCriteria", "labels", "dependencyIds", "evidenceIds", "verificationIds"],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "kind": { "enum": ["issue", "task", "sprint", "milestone"] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": { "enum": ["draft", "ready", "reserved", "in_progress", "blocked", "needs_verification", "verified", "closed", "cancelled"] },
    "priority": { "enum": ["low", "normal", "high", "critical"] },
    "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
    "labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "binding": { "$ref": "#/$defs/binding" },
    "parentId": { "type": "string" },
    "dependencyIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "verificationIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "requiredCloseoutGates": {
      "type": "array",
      "items": { "$ref": "#/$defs/requiredCloseoutGate" }
    },
    "reservationId": { "type": "string" },
    "closedAt": { "type": "string", "format": "date-time" },
    "closedReason": { "type": "string" }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["id", "schemaVersion", "createdAt", "updatedAt", "createdBy", "updatedBy", "sourceRefs", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^bw_work_[a-f0-9]{12,64}$" },
        "schemaVersion": { "const": "boreal.runtime.v1" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "object" },
        "updatedBy": { "type": "object" },
        "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sourceRefs": { "type": "array" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "actor": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["human", "agent", "system"] },
        "displayName": { "type": "string" }
      }
    },
    "binding": {
      "type": "object",
      "properties": {
        "workflowRef": { "type": "string", "minLength": 1 },
        "outputContract": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "templateNodeKey": { "type": "string", "minLength": 1 },
        "templateId": { "type": "string", "minLength": 1 },
        "templateVersion": { "type": "string", "minLength": 1 },
        "templateRunId": { "type": "string", "minLength": 1 }
      }
    },
    "requiredCloseoutGate": {
      "type": "object",
      "required": [
        "id",
        "subjectType",
        "subjectId",
        "kind",
        "scope",
        "status",
        "requiredEvidenceKinds",
        "requiredOutcome",
        "minEvidenceCount",
        "createdAt",
        "createdBy"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^bw_gate_[a-f0-9]{12,64}$" },
        "subjectType": { "enum": ["work", "sprint", "phase", "milestone", "project"] },
        "subjectId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["verification", "checkpoint", "review", "audit"] },
        "scope": { "enum": ["self", "direct_children", "descendants"] },
        "status": { "enum": ["open", "satisfied", "forced"] },
        "requiredEvidenceKinds": {
          "type": "array",
          "items": { "enum": ["command", "test", "diff", "review", "artifact", "note"] }
        },
        "requiredOutcome": { "const": "passed" },
        "minEvidenceCount": { "type": "integer", "minimum": 0 },
        "declaredCommand": { "type": "string", "minLength": 1 },
        "expectedObservable": { "type": "string", "minLength": 1 },
        "requiredTrustLevels": {
          "type": "array",
          "items": { "enum": ["legacy_unattested", "self_reported", "boreal_witnessed", "external_attested"] },
          "uniqueItems": true,
          "minItems": 1
        },
        "requireCurrentRevision": { "type": "boolean" },
        "requireCurrentGitHead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "$ref": "#/$defs/actor" },
        "satisfiedBy": {
          "type": "object",
          "properties": {
            "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "verificationIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "agentSummaryIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "commitShas": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "dirtyPathNotes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "force": {
          "type": "object",
          "required": ["reason", "comment", "actor", "forcedAt"],
          "properties": {
            "reason": {
              "enum": [
                "review_unavailable",
                "audit_unavailable",
                "external_review_record",
                "legacy_backfill",
                "user_accepted_risk",
                "emergency_closeout"
              ]
            },
            "comment": { "type": "string", "minLength": 1 },
            "actor": { "$ref": "#/$defs/actor" },
            "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "forcedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  }
}
