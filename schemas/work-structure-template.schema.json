{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boreal.work/schemas/work-structure-template.schema.json",
  "title": "Boreal Work Structure Template",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "variables", "nodes"],
  "properties": {
    "schemaVersion": { "const": "boreal.work-template.v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": ["string", "number"] },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "variables": {
      "type": "array",
      "items": { "$ref": "#/$defs/variable" },
      "default": []
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" },
      "default": []
    }
  },
  "$defs": {
    "variable": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "description": { "type": "string" },
        "default": { "type": ["string", "number", "boolean"] },
        "required": { "type": "boolean", "default": true }
      }
    },
    "node": {
      "type": "object",
      "required": ["key", "kind", "title"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["issue", "task", "sprint", "milestone"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "priority": { "enum": ["low", "normal", "high", "critical"] },
        "labels": { "type": "array", "items": { "type": "string" }, "default": [] },
        "acceptance": { "type": "array", "items": { "type": "string" }, "default": [] },
        "gates": { "type": "array", "items": { "$ref": "#/$defs/gate" }, "default": [] },
        "binding": { "$ref": "#/$defs/binding" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" }, "default": [] }
      }
    },
    "gate": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["verification", "checkpoint", "review", "audit"] },
        "scope": { "enum": ["self", "direct_children", "descendants"] },
        "requiredEvidenceKinds": {
          "type": "array",
          "items": { "enum": ["command", "test", "diff", "review", "artifact", "note"] }
        },
        "minEvidenceCount": { "type": "integer", "minimum": 0 },
        "declaredCommand": { "type": "string", "minLength": 1 },
        "expectedObservable": { "type": "string", "minLength": 1 }
      }
    },
    "binding": {
      "type": "object",
      "oneOf": [
        { "required": ["workflow"] },
        { "required": ["workflowRef"] },
        { "required": ["contract"] },
        { "required": ["outputContract"] },
        { "required": ["command"] }
      ],
      "properties": {
        "workflow": { "type": "string", "minLength": 1 },
        "workflowRef": { "type": "string", "minLength": 1 },
        "contract": { "type": "string", "minLength": 1 },
        "outputContract": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      }
    },
    "edge": {
      "type": "object",
      "required": ["dependent", "dependency"],
      "properties": {
        "dependent": { "type": "string", "minLength": 1 },
        "dependency": { "type": "string", "minLength": 1 }
      }
    }
  }
}
