{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boreal.work/schemas/operations/runtime-operation.schema.json",
  "title": "Boreal Runtime Operation",
  "type": "object",
  "required": [
    "meta",
    "sessionId",
    "commandPath",
    "argv",
    "actorId",
    "startedAt",
    "finishedAt",
    "exitCode",
    "status",
    "stateChanged",
    "generatedArtifactsChanged",
    "eventIds"
  ],
  "properties": {
    "meta": { "type": "object" },
    "sessionId": { "type": "string", "minLength": 1 },
    "commandPath": { "type": "string", "minLength": 1 },
    "argv": { "type": "array", "items": { "type": "string" } },
    "actorId": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "exitCode": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["started", "in_progress", "succeeded", "failed", "partial", "unknown"] },
    "stateChanged": { "type": "boolean" },
    "generatedArtifactsChanged": { "type": "boolean" },
    "eventIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "errorCode": { "type": "string" },
    "errorMessage": { "type": "string", "maxLength": 2000 },
    "phase": { "type": "string", "minLength": 1, "maxLength": 128 },
    "durationMs": { "type": "integer", "minimum": 0 },
    "lockWaitMs": { "type": "integer", "minimum": 0 },
    "processId": { "type": "integer", "minimum": 0 },
    "host": { "type": "string", "minLength": 1, "maxLength": 255 },
    "storageHeadSeq": { "type": "integer", "minimum": 0 },
    "stateChangeOutcome": { "enum": ["changed", "unchanged", "partial", "unknown"] },
    "generatedArtifactOutcome": { "enum": ["changed", "unchanged", "partial", "unknown"] },
    "auditOutcome": { "enum": ["complete", "incomplete", "unknown"] },
    "resultUri": { "type": "string", "minLength": 1, "maxLength": 1024 }
  }
}
