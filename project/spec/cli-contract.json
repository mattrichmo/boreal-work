{
  "fixture_version": "p0-03.v2",
  "contract": "boreal.cli.v1",
  "program": "bwrk",
  "protocol_version": "2",
  "status": "frozen fixture; implementation is not implied",
  "json_rule": "Every command invoked with --json returns boreal.protocol.envelope.v1. Human output is a rendering of the same DTO and never a second transition path.",
  "grammar": {
    "invocation": "bwrk [GLOBAL_OPTIONS] PATH [PATH_OPTIONS] [--json]",
    "path": "one or more lower-case command tokens separated by a single space",
    "option": "--name VALUE; boolean options take no VALUE",
    "short_options": "not part of the v2 canonical grammar",
    "unknown_option": "invalid_argument with field path and help recovery",
    "unknown_path": "invalid_argument with command_path and help recovery",
    "duration": "positive unsigned integer followed by exactly one of ms, s, m, h, d",
    "revision": "unsigned base-10 integer",
    "limit": "integer 1..100",
    "id": "opaque typed identifier; must be project-bound where a project record is addressed",
    "path_value": "absolute path or project-relative path resolved under the active project root",
    "json_placement": "--json is accepted after GLOBAL_OPTIONS or at the end of PATH_OPTIONS",
    "shell": false
  },
  "global_options": [
    {"name": "--json", "type": "boolean", "meaning": "emit the versioned JSON envelope"},
    {"name": "--protocol-version", "type": "literal:2", "meaning": "negotiate protocol version"},
    {"name": "--project", "type": "project_id_or_path", "meaning": "select the local project"},
    {"name": "--actor", "type": "actor_id", "meaning": "accountable actor identity"},
    {"name": "--session", "type": "session_id", "meaning": "durable harness session identity"},
    {"name": "--operation-id", "type": "operation_id", "meaning": "idempotency key for one mutation"},
    {"name": "--expected-revision", "type": "revision", "meaning": "conditional mutation/read snapshot"},
    {"name": "--revision", "type": "revision", "alias_of": "--expected-revision", "meaning": "read snapshot compatibility spelling"},
    {"name": "--actor-role", "type": "enum:agent|reviewer|operator|publisher", "meaning": "authorized role for scoped actions"},
    {"name": "--operator-reason", "type": "reason_code", "meaning": "required reason for operator override"},
    {"name": "--reviewer", "type": "actor_id", "meaning": "independent reviewer identity"},
    {"name": "--gate", "type": "gate_id", "meaning": "acceptance gate identity"},
    {"name": "--include-expiry", "type": "boolean", "meaning": "include bounded expiry recovery fields"},
    {"name": "--close", "type": "boolean", "meaning": "submit durable close intent"},
    {"name": "--release", "type": "boolean", "meaning": "release the current attempt"}
  ],
  "identity_options": {
    "attempt": {"name": "--attempt", "type": "attempt_id", "required_for": ["fenced progress and closeout when current attempt is known"]},
    "fence": {"name": "--fence", "type": "positive integer", "required_for": ["fenced progress and closeout"]},
    "work": {"name": "--work", "type": "work_id", "required_for": ["evidence and some guide/status filters"]}
  },
  "attempt_time_options": {
    "--lease-ttl": {
      "type": "duration",
      "default": "30m",
      "meaning": "renewable ownership lease from the authoritative claimed_at clock",
      "renewable": true,
      "hard": false,
      "output_field": "lease_deadline"
    },
    "--ttl": {
      "type": "duration",
      "alias_of": "--lease-ttl",
      "meaning": "legacy spelling for the renewable ownership lease",
      "renewable": true,
      "hard": false,
      "output_field": "lease_deadline"
    },
    "--time-limit": {
      "type": "duration",
      "default": "2h",
      "meaning": "hard attempt completion budget measured from claimed_at",
      "renewable": false,
      "hard": true,
      "output_field": "max_attempt_deadline"
    },
    "rules": [
      "--ttl and --lease-ttl are mutually exclusive aliases; supplying both is invalid_argument.",
      "--lease-ttl and --time-limit may be supplied together because they set different clocks.",
      "Omitting --time-limit records deadline_source=default_time_limit_2h.",
      "Supplying --time-limit records deadline_source=explicit_time_limit and never changes lease semantics.",
      "Heartbeat and lease renewal never extend max_attempt_deadline.",
      "At equality or later, an open attempt follows expired_review fencing and is not silently requeued."
    ]
  },
  "aliases": [
    {"path": "status", "canonical_path": "prime", "disposition": "keep_spelling", "meaning": "v1 compatibility alias; never active status"},
    {"path": "start", "canonical_path": "agent start", "disposition": "keep_spelling", "meaning": "safe claim-or-resume entry point"},
    {"path": "view", "canonical_path": "dashboard", "disposition": "keep_spelling", "meaning": "dashboard view"},
    {"path": "capture", "canonical_path": "raw add", "disposition": "keep_spelling", "meaning": "raw immutable intake"},
    {"path": "install", "canonical_path": "setup", "disposition": "keep_behavior", "meaning": "setup and adapter installation compatibility"},
    {"path": "done <WORK_REF>", "canonical_path": "agent finish <WORK_REF> --close", "disposition": "keep_behavior", "meaning": "only after the same structured gates and close intent pass"},
    {"path": "pause <WORK_REF>", "canonical_path": "work edit <WORK_REF> --dispatch-policy paused", "disposition": "keep_behavior", "meaning": "policy pause; release never clears it"}
  ],
