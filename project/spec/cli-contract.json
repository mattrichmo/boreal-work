    "fenced_mutation": ["ok", "invalid", "not_found", "conflict", "stale", "busy", "blocked", "permission", "service_unavailable", "failed", "unknown_outcome"],
    "guide": ["ok", "invalid", "not_found", "blocked", "service_unavailable", "failed", "unknown_outcome"]
  },
