  "exit_classes": {
    "ok": {"code": 0, "meaning": "transport succeeded and application outcome is changed, unchanged, or already-terminal"},
    "invalid": {"code": 2, "meaning": "request, protocol, command path, duration, dependency, or trusted-action validation failed"},
    "not_found": {"code": 3, "meaning": "addressed project record is absent"},
    "conflict": {"code": 4, "meaning": "current owner or expected revision differs"},
    "stale": {"code": 5, "meaning": "context, receipt, attempt, or fence is no longer current"},
    "busy": {"code": 6, "meaning": "bounded service/writer queue cannot accept the request now"},
    "blocked": {"code": 7, "meaning": "policy, prerequisite, expiry review, or acceptance gate prevents the requested action"},
    "permission": {"code": 8, "meaning": "actor role or project boundary denies the operation"},
    "service_unavailable": {"code": 9, "meaning": "no compatible local service or supported offline boundary is available"},
    "failed": {"code": 10, "meaning": "transport succeeded but a typed application/runner failure occurred"},
    "unknown_outcome": {"code": 11, "meaning": "mutation outcome was not observed; read operation_id before retry"}
  },
  "exit_profiles": {
    "read": ["ok", "invalid", "not_found", "service_unavailable", "failed"],
