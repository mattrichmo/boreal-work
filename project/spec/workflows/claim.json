{
  "schema_version": "boreal.workflow_asset.v1",
  "asset_version": "1.3.0",
  "ref": "boreal.workflow.claim.v1",
  "kind": "claim",
  "title": "Claim, resume, and checkpoint one fenced attempt",
  "refs": {
    "route": "boreal.workflow.route.v1",
    "context": "boreal.workflow.context.v1",
    "plan": "boreal.workflow.plan.v1",
    "handoff": "boreal.workflow.handoff.v1"
  },
  "allowed_commands": [
    "bwrk session show --project <project_id> --session <session_id> --json",
    "bwrk agent guide --project <project_id> --work <work_id> --json",
    "bwrk agent resume --project <project_id> --session <session_id> --attempt <attempt_id> --json",
    "bwrk agent start <work_id> --project <project_id> --source-version <source_version_id> --config-identity <config_identity> --expected-revision <revision> --session <session_id> --json",
    "bwrk work accept <project_id> <work_id> --attempt <attempt_id> --fence <fence> --json",
    "bwrk agent heartbeat --project <project_id> --work <work_id> --attempt <attempt_id> --fence <fence> --json",
    "bwrk agent renew --project <project_id> --work <work_id> --attempt <attempt_id> --fence <fence> --lease-ttl <lease_ttl> --json",
    "bwrk work checkpoint --work <work_id> --input <input_path> --expected-revision <revision> --reason <reason> --yes --json",
    "bwrk agent release <work_id> --project <project_id> --attempt <attempt_id> --fence <fence> --json",
    "bwrk agent next --project <project_id> --work <work_id> --json"
  ],
  "typed_inputs": [
    {
      "name": "work_id",
      "type": "work_id",
      "required": true,
      "source": "guidance",
      "validation": "ready_and_project_bound"
    },
    {
      "name": "session_id",
      "type": "session_id",
      "required": true,
      "source": "credential",
      "validation": "one_current_execution"
    },
    {
      "name": "attempt_id",
      "type": "attempt_id",
      "required": false,
      "source": "attempt",
      "validation": "current_or_resume_bound"
    },
    {
      "name": "fence",
      "type": "fence",
      "required": false,
      "source": "attempt",
      "validation": "stale_write_rejected"
    },
    {
      "name": "lease_ttl",
      "type": "duration",
      "required": true,
      "source": "policy_or_request",
      "validation": "renewable_lease"
    },
    {
      "name": "heartbeat_interval",
      "type": "duration",
      "required": true,
      "source": "current_attempt_or_service_response",
      "validation": "harness_scheduled_independently_from_lease_renewal_during_long_tool_calls"
    },
    {
      "name": "lease_renewal_interval",
      "type": "duration",
      "required": true,
      "source": "current_attempt_or_service_response",
      "validation": "harness_scheduled_separately_from_heartbeat_during_long_tool_calls"
    },
    {
      "name": "liveness_scheduler_owner",
      "type": "harness_id",
      "required": true,
      "source": "trusted_harness",
      "validation": "harness_owns_background_liveness_schedule"
    },
    {
      "name": "process_stop_confirmed",
      "type": "boolean",
      "required": false,
      "source": "harness_process_supervisor",
      "validation": "must_be_true_before_recovery_releases_live_resources"
    },
    {
      "name": "time_limit",
      "type": "duration",
      "required": false,
      "source": "request",
      "default": "2h",
      "validation": "hard_budget_not_renewable"
    },
    {
      "name": "checkpoint_scope",
      "type": "bounded_string",
      "required": false,
      "source": "typed_request",
      "validation": "display_data_only"
    },
    {
      "name": "expected_revision",
      "type": "revision",
      "required": true,
      "source": "guidance",
      "validation": "compare_and_swap"
    },
    {
      "name": "operation_id",
      "type": "operation_id",
      "required": true,
      "source": "client",
      "validation": "idempotent"
    },
    {
      "name": "server_action",
      "type": "action_descriptor",
      "required": true,
      "source": "canonical_status_or_command_response",
      "validation": "target_project_actor_session_revisions_confirmation_and_denials_must_match; guidance_is_not_authority"
    }
  ],
  "finish_criteria": [
    {
      "id": "claim.eligibility",
      "type": "atomic_current_evaluator_pass",
      "required": true
    },
    {
      "id": "claim.cardinality",
      "type": "one_current_attempt_per_work_and_session",
      "required": true
    },
    {
      "id": "claim.deadlines",
      "type": "lease_and_hard_budget_recorded_separately",
      "required": true
    },
    {
      "id": "claim.fence",
      "type": "monotonic_attempt_fence",
      "required": true
    },
    {
      "id": "claim.progress",
      "type": "acceptance_heartbeat_and_checkpoint_share_current_fence",
      "required": true
    },
    {
      "id": "claim.authority",
      "type": "mutation_authorized_again_inside_canonical_transaction",
      "required": true
    },
    {
      "id": "claim.liveness",
      "type": "heartbeat_and_lease_renewal_use_separate_harness_timers_with_service_returned_cadence",
      "required": true
    },
    {
      "id": "claim.long_tools",
      "type": "harness_keeps_liveness_timers_running_during_agent_tool_calls",
      "required": true
    },
    {
      "id": "claim.recovery",
      "type": "resource_recovery_waits_for_harness_process_stop_confirmation_and_never_breaks_live_locks",
      "required": true
    }
  ],
  "next_refs": [
    "boreal.workflow.handoff.v1",
    "boreal.workflow.context.v1",
    "boreal.workflow.finish.v1"
  ],
  "state_transition_owner": "boreal.application.v2",
  "required_server_actions": [
    "claim",
    "accept_attempt",
    "start_attempt",
    "checkpoint",
    "release"
  ]
}
