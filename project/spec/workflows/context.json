{
  "schema_version": "boreal.workflow_asset.v1",
  "asset_version": "1.1.0",
  "ref": "boreal.workflow.context.v1",
  "kind": "context",
  "title": "Build a bounded project, work, decision, and source context capsule",
  "refs": {
    "route": "boreal.workflow.route.v1",
    "health": "boreal.workflow.health.v1",
    "memory": "boreal.workflow.memory.v1"
  },
  "allowed_commands": [
    "bwrk prime --json",
    "bwrk status --json",
    "bwrk work show <work_id> --json",
    "bwrk work list --json",
    "bwrk source list --json",
    "bwrk source show <source_id> --json",
    "bwrk memory search --json"
  ],
  "typed_inputs": [
    {
      "name": "project_id",
      "type": "project_id",
      "required": true,
      "source": "session",
      "validation": "project_scope"
    },
    {
      "name": "project_revision",
      "type": "revision",
      "required": true,
      "source": "store_snapshot",
      "validation": "monotonic"
    },
    {
      "name": "session_id",
      "type": "session_id",
      "required": true,
      "source": "credential",
      "validation": "one_current_execution"
    },
    {
      "name": "work_id",
      "type": "nullable_work_id",
      "required": false,
      "source": "request_or_attempt",
      "validation": "project_bound"
    },
    {
      "name": "decision_id",
      "type": "nullable_decision_id",
      "required": false,
      "source": "request",
      "validation": "project_bound"
    },
    {
      "name": "source_id",
      "type": "nullable_source_id",
      "required": false,
      "source": "request",
      "validation": "project_bound"
    },
    {
      "name": "raw_id",
      "type": "nullable_raw_id",
      "required": false,
      "source": "request",
      "validation": "project_bound"
    },
    {
      "name": "source_snapshot_hash",
      "type": "sha256",
      "required": true,
      "source": "source_engine",
      "validation": "digest_format"
    },
    {
      "name": "memory_refs",
      "type": "bounded_reference_array",
      "required": false,
      "source": "retrieval",
      "validation": "project_scoped_and_digest_checked"
    },
    {
      "name": "server_action",
      "type": "action_descriptor",
      "required": false,
      "source": "canonical_status_or_command_response",
      "validation": "target_project_actor_session_revisions_confirmation_and_denials_must_match; guidance_is_not_authority"
    }
  ],
  "finish_criteria": [
    {
      "id": "context.revision",
      "type": "single_project_revision",
      "required": true
    },
    {
      "id": "context.bounded",
      "type": "bounded_payload",
      "required": true
    },
    {
      "id": "context.subject",
      "type": "requested_subjects_are_project_bound",
      "required": true
    },
    {
      "id": "context.provenance",
      "type": "source_and_config_identity",
      "required": true
    },
    {
      "id": "context.authority",
      "type": "mutation_authorized_again_inside_canonical_transaction",
      "required": true
    }
  ],
  "next_refs": [
    "boreal.workflow.plan.v1",
    "boreal.workflow.claim.v1",
    "boreal.workflow.handoff.v1"
  ],
  "state_transition_owner": "boreal.application.v2",
  "required_server_actions": []
}
