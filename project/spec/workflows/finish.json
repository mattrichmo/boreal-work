{
  "schema_version": "boreal.workflow_asset.v1",
  "asset_version": "1.3.0",
  "ref": "boreal.workflow.finish.v1",
  "kind": "finish",
  "title": "Attach evidence, verify, and close or release work",
  "refs": {
    "route": "boreal.workflow.route.v1",
    "context": "boreal.workflow.context.v1",
    "claim": "boreal.workflow.claim.v1",
    "review": "boreal.workflow.review.v1",
    "audit": "boreal.workflow.audit.v1",
    "handoff": "boreal.workflow.handoff.v1"
  },
  "allowed_commands": [
    "bwrk agent guide --project <project_id> --work <work_id> --json",
    "bwrk work show <project_id> <work_id> --json",
    "bwrk source add <project_id> --input <result_path> --origin <origin> --media-type <media_type> --expected-revision <revision> --session <session_id> --json",
    "bwrk evidence bind-result --project <project_id> --work <work_id> --attempt <attempt_id> --fence <fence> --source-version <source_version_id> --content-digest <content_digest> --expected-entity-revision <entity_revision> --expected-proof-revision <proof_revision> --operation <operation_id> --actor <actor_id> --session <session_id> --json",
    "bwrk evidence run --project <project_id> --work <work_id> --gate <gate_id> --attempt <attempt_id> --fence <fence> --json",
    "bwrk agent finish <work_id> --close --project <project_id> --attempt <attempt_id> --fence <fence> --receipt <receipt_path> --summary <summary_path> --expected-revision <revision> --session <session_id> --json",
    "bwrk operation show <project_id> <operation_id> --json",
    "bwrk summary compose --project <project_id> --work <work_id> --json",
    "bwrk summary create --project <project_id> --work <work_id> --input <input_path> --attempt <attempt_id> --fence <fence> --expected-revision <revision> --json",
    "bwrk agent next --project <project_id> --work <work_id> --json"
  ],
  "typed_inputs": [
    {
      "name": "project_id",
      "type": "project_id",
      "required": true,
      "source": "session",
      "validation": "project_scope"
    },
    {
      "name": "work_id",
      "type": "work_id",
      "required": true,
      "source": "attempt",
      "validation": "subject_match"
    },
    {
      "name": "attempt_id",
      "type": "attempt_id",
      "required": true,
      "source": "attempt",
      "validation": "current_fence"
    },
    {
      "name": "fence",
      "type": "fence",
      "required": true,
      "source": "attempt",
      "validation": "stale_write_rejected"
    },
    {
      "name": "expected_entity_revision",
      "type": "entity_revision",
      "required": true,
      "source": "canonical_action_descriptor",
      "validation": "compare_and_swap"
    },
    {
      "name": "expected_proof_revision",
      "type": "proof_revision",
      "required": true,
      "source": "canonical_action_descriptor",
      "validation": "result_binding_supersedes_stale_proof"
    },
    {
      "name": "result_source_identity",
      "type": "source_identity",
      "required": true,
      "source": "operator_source_capture_receipt",
      "validation": "same_project_registered_version_and_digest_revalidated"
    },
    {
      "name": "result_content_digest",
      "type": "sha256",
      "required": true,
      "source": "source_catalog_readback",
      "validation": "exact_identity_digest_match"
    },
    {
      "name": "operation_id",
      "type": "operation_id",
      "required": true,
      "source": "versioned_request_envelope",
      "validation": "idempotent_durable_readback"
    },
    {
      "name": "source_version_id",
      "type": "source_version_id",
      "required": true,
      "source": "claim_or_bound_result",
      "validation": "verifier_uses_bound_result_when_present_claim_input_remains_immutable"
    },
    {
      "name": "config_identity",
      "type": "config_identity",
      "required": true,
      "source": "authoritative_attempt",
      "validation": "read_pinned_configuration_not_client_supplied"
    },
    {
      "name": "acceptance_profile_ref",
      "type": "workflow_ref",
      "required": true,
      "source": "authoritative_work",
      "validation": "read_pinned_profile_not_client_supplied"
    },
    {
      "name": "receipt_ids",
      "type": "receipt_id_array",
      "required": true,
      "source": "evidence",
      "validation": "subject_source_config_policy_and_proof_revision_match"
    },
    {
      "name": "summary_id",
      "type": "nullable_summary_id",
      "required": false,
      "source": "durable_summary_record",
      "validation": "subject_and_attempt_match"
    },
    {
      "name": "close_intent",
      "type": "boolean",
      "required": true,
      "source": "typed_request",
      "validation": "durable_fenced_intent"
    },
    {
      "name": "server_action",
      "type": "action_descriptor",
      "required": true,
      "source": "canonical_status_or_command_response",
      "validation": "target_project_actor_session_revisions_confirmation_and_denials_must_match; guidance_is_not_authority"
    }
  ],
  "finish_criteria": [
    {
      "id": "finish.result",
      "type": "operator_captures_exact_produced_artifact_then_worker_binding_pins_it_to_current_attempt_and_proof_revision",
      "required": true
    },
    {
      "id": "finish.invalidations",
      "type": "result_change_invalidates_prior_receipt_submission_and_review_applicability",
      "required": true
    },
    {
      "id": "finish.evidence",
      "type": "all_required_structured_proof_attached_to_bound_result",
      "required": true
    },
    {
      "id": "finish.verification",
      "type": "all_required_structured_proof_verified_against_bound_result_source_and_pinned_config",
      "required": true
    },
    {
      "id": "finish.review",
      "type": "profile_declared_review_gate_only_and_review_decision_matches_current_submission",
      "required": true
    },
    {
      "id": "finish.intent",
      "type": "valid_close_intent_and_current_fenced_action_descriptor",
      "required": true
    },
    {
      "id": "finish.commit",
      "type": "atomic_summary_closeout_and_release_with_durable_readback",
      "required": true
    },
    {
      "id": "finish.dependencies",
      "type": "closed_only_default_satisfaction",
      "required": true
    },
    {
      "id": "finish.authority",
      "type": "mutation_authorized_again_inside_canonical_transaction",
      "required": true
    }
  ],
  "next_refs": [
    "boreal.workflow.review.v1",
    "boreal.workflow.audit.v1",
    "boreal.workflow.handoff.v1",
    "boreal.workflow.route.v1"
  ],
  "state_transition_owner": "boreal.application.v2",
  "required_server_actions": [
    "finish_close"
  ]
}
