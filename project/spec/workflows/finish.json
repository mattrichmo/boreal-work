{
  "schema_version": "boreal.workflow_asset.v1",
  "asset_version": "1.1.0",
  "ref": "boreal.workflow.finish.v1",
  "kind": "finish",
  "title": "Attach evidence, verify, and close or release work",
  "refs": {
    "route": "boreal.workflow.route.v1",
    "context": "boreal.workflow.context.v1",
    "claim": "boreal.workflow.claim.v1",
    "review": "boreal.workflow.review.v1",
    "audit": "boreal.workflow.audit.v1",
    "handoff": "boreal.workflow.handoff.v1"
  },
  "allowed_commands": [
    "bwrk agent guide --json",
    "bwrk work show <work_id> --json",
    "bwrk evidence run <gate_id> --input <input_path> --json",
    "bwrk agent finish <work_id> --close --expected-revision <revision> --json",
    "bwrk operation show <operation_id> --json"
  ],
  "typed_inputs": [
    {
      "name": "project_id",
      "type": "project_id",
      "required": true,
      "source": "session",
      "validation": "project_scope"
    },
    {
      "name": "work_id",
      "type": "work_id",
      "required": true,
      "source": "attempt",
      "validation": "subject_match"
    },
    {
      "name": "sprint_id",
      "type": "nullable_work_id",
      "required": false,
      "source": "rollup",
      "validation": "kind_sprint_and_project_bound"
    },
    {
      "name": "attempt_id",
      "type": "attempt_id",
      "required": true,
      "source": "attempt",
      "validation": "current_fence"
    },
    {
      "name": "fence",
      "type": "fence",
      "required": true,
      "source": "attempt",
      "validation": "stale_write_rejected"
    },
    {
      "name": "acceptance_profile_ref",
      "type": "workflow_ref",
      "required": true,
      "source": "work",
      "validation": "version_match"
    },
    {
      "name": "receipt_ids",
      "type": "receipt_id_array",
      "required": true,
      "source": "evidence",
      "validation": "subject_source_config_policy_match"
    },
    {
      "name": "summary_id",
      "type": "nullable_summary_id",
      "required": false,
      "source": "summary",
      "validation": "subject_match"
    },
    {
      "name": "close_intent",
      "type": "boolean",
      "required": true,
      "source": "typed_request",
      "validation": "durable_fenced_intent"
    },
    {
      "name": "server_action",
      "type": "action_descriptor",
      "required": true,
      "source": "canonical_status_or_command_response",
      "validation": "target_project_actor_session_revisions_confirmation_and_denials_must_match; guidance_is_not_authority"
    }
  ],
  "finish_criteria": [
    {
      "id": "finish.evidence",
      "type": "all_required_structured_proof_attached",
      "required": true
    },
    {
      "id": "finish.verification",
      "type": "all_required_structured_proof_verified",
      "required": true
    },
    {
      "id": "finish.review",
      "type": "profile_declared_review_gate_only",
      "required": true
    },
    {
      "id": "finish.intent",
      "type": "valid_close_intent",
      "required": true
    },
    {
      "id": "finish.commit",
      "type": "atomic_summary_closeout_and_release",
      "required": true
    },
    {
      "id": "finish.dependencies",
      "type": "closed_only_default_satisfaction",
      "required": true
    },
    {
      "id": "finish.authority",
      "type": "mutation_authorized_again_inside_canonical_transaction",
      "required": true
    }
  ],
  "next_refs": [
    "boreal.workflow.review.v1",
    "boreal.workflow.audit.v1",
    "boreal.workflow.handoff.v1",
    "boreal.workflow.route.v1"
  ],
  "state_transition_owner": "boreal.application.v2",
  "required_server_actions": [
    "finish_close"
  ]
}
