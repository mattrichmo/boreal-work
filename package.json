{
  "name": "boreal-work",
  "version": "0.1.0",
  "private": true,
  "description": "Local runtime for evidence-backed work, project memory, and agent handoff.",
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "audit:release-boundary": "node tools/audit-release-boundary.mjs",
    "bwrk": "tsx --tsconfig tsconfig.base.json apps/cli/src/index.ts",
    "build": "tsc -b && pnpm --dir apps/cli build:dist",
    "check": "tsc -b --pretty false",
    "cli:dist": "pnpm --dir apps/cli build:dist",
    "ci:doctor:strict": "node tools/ci-doctor-strict.mjs",
    "clean": "pnpm -r exec rm -rf dist tsconfig.tsbuildinfo && rm -rf coverage",
    "console:browser-smoke": "pnpm --dir apps/console browser-smoke",
    "console:build": "pnpm --dir apps/console build",
    "console:dev": "pnpm --dir apps/console dev",
    "console:render": "pnpm --dir apps/console render",
    "console:smoke": "pnpm --dir apps/console smoke",
    "daemon:status": "pnpm --dir apps/daemon status",
    "daemon:watch:once": "pnpm --dir apps/daemon watch:once",
    "doctor:strict": "tsx --tsconfig tsconfig.base.json apps/cli/src/index.ts doctor --workspace . --strict --json",
    "install:local": "node node_modules/typescript/bin/tsc -b && node tools/install-local-bwrk.mjs",
    "mcp:dev": "pnpm --dir apps/mcp dev",
    "release:brew:verify": "node tools/verify-homebrew-formula.mjs",
    "release:npm:dry-run": "node tools/npm-publish-dry-run.mjs",
    "release:npm:pack": "node tools/smoke-npm-package.mjs --pack-only",
    "release:npm:prepare": "node tools/prepare-npm-package.mjs",
    "release:npm:smoke": "node tools/smoke-npm-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
