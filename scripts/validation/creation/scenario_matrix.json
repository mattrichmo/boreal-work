{
  "matrix_version": "boreal.creation-scenarios/1",
  "fixtures": [
    "basic-hierarchy",
    "linear-chain",
    "diamond-graph",
    "mixed-status",
    "timer-expiry",
    "evidence-closeout",
    "concurrency-race",
    "large-history",
    "restart-recovery"
  ],
  "families": [
    {
      "id": "workspace",
      "coverage": "black_box:bootstrap.registry",
      "checks": [
        "fresh project initialization",
        "idempotent initialization",
        "existing canonical database is not reset",
        "explicit and inferred project selection",
        "missing/unknown project errors",
        "v2 binary, protocol, schema, and registry identity",
        "database integrity and isolated fixture state"
      ]
    },
    {
      "id": "hierarchy_creation",
      "coverage": "black_box:hierarchy.create-and-validate",
      "checks": [
        "root milestone creation",
        "sprint under milestone",
        "task under sprint",
        "multiple children and sibling ordering",
        "invalid root sprint",
        "missing/wrong/cross-project parent",
        "duplicate work ID",
        "invalid kind/title/priority inputs",
        "description, dispatch policy, and acceptance profile fields",
        "work list/show hierarchy and rollups"
      ]
    },
    {
      "id": "planning_revisions",
      "coverage": "black_box:planning.attributes-and-revisions",
      "checks": [
        "mutable title/description/priority edits",
        "expected revision success",
        "stale revision rejection without a write",
        "hard hold add and status impact",
        "hold resolution with reason",
        "paused/operator-only dispatch policy",
        "planning mutation audit and operation identity"
      ]
    },
    {
