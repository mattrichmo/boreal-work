        "ready claim",
        "claimed-but-not-accepted state",
        "accept/start transition",
        "one current attempt per work/session",
        "wrong actor/harness/session rejection",
        "competing claim race",
        "heartbeat versus durable checkpoint",
        "renewable lease",
        "release and reclaim",
        "monotonic fencing",
        "stale fence/revision rejection",
        "resume after interruption",
        "idempotent lifecycle replay"
