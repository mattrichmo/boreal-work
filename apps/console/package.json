{
  "name": "@boreal/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "browser-smoke": "pnpm build && node dist/browser-smoke.js --workspace ../..",
    "dev": "pnpm build && node dist/server.js --workspace ../..",
    "render": "pnpm build && node dist/render-file.js --workspace ../..",
    "smoke": "pnpm build && node dist/smoke.js --workspace ../.."
  },
  "dependencies": {
    "@boreal/ui-model": "workspace:*",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
