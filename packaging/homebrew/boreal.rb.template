class Boreal < Formula
  desc "Local, proof-gated work coordination for agents and humans"
  homepage "https://github.com/mattrichmo/boreal-work"
  license "MIT"
  version "{{VERSION}}"

  if OS.mac? && Hardware::CPU.arm?
    url "https://github.com/mattrichmo/boreal-work/releases/download/v{{VERSION}}/bwrk-v{{VERSION}}-aarch64-apple-darwin.tar.gz"
    sha256 "{{SHA256_AARCH64_APPLE_DARWIN}}"
  elsif OS.mac? && Hardware::CPU.intel?
    url "https://github.com/mattrichmo/boreal-work/releases/download/v{{VERSION}}/bwrk-v{{VERSION}}-x86_64-apple-darwin.tar.gz"
    sha256 "{{SHA256_X86_64_APPLE_DARWIN}}"
  elsif OS.linux? && Hardware::CPU.intel?
    url "https://github.com/mattrichmo/boreal-work/releases/download/v{{VERSION}}/bwrk-v{{VERSION}}-x86_64-unknown-linux-gnu.tar.gz"
    sha256 "{{SHA256_X86_64_UNKNOWN_LINUX_GNU}}"
  else
    odie "Boreal does not publish a binary for this platform yet"
  end

  depends_on "node"

  def install
    bin.install "bin/bwrk"
    (lib/"boreal").install "lib/boreal/tui"
    (share/"boreal").install "share/boreal/release.json"
    (share/"boreal").install "share/boreal/LICENSE"
  end

  test do
    assert_match "bwrk", shell_output("#{bin}/bwrk --version")
    assert_predicate lib/"boreal/tui/entrypoint.js", :exist?
    assert_predicate share/"boreal/release.json", :exist?
  end
end
